!configs/ibm_config.yaml.example

# Database
*.db
*.sqlite
*.sqlite3

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Jupyter Notebooks
.ipynb_checkpoints/
*.ipynb

# OS
Thumbs.db
.DS_Store

