# .gitignore for SCDO Project

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
venv/
ENV/
env/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
logs/
*.log

# Output files
output/
# *.pdf  # Temporarily commented out
*.xlsx
*.docx

# Temporary files
tmp/
temp/
*.tmp

# Configuration (contains sensitive data)
.env
.env.*
!.env.example

# Secret keys & certificates
*.pem
*.key
*.p12

# Cache
cache/

# Database
*.db
*.sqlite
*.sqlite3

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Jupyter Notebooks
.ipynb_checkpoints/
*.ipynb

# OS
Thumbs.db
.DS_Store

# Uploaded files
uploads/

# Node.js
node_modules/
