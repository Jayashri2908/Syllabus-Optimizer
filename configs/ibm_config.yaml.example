# IBM Cloud Configuration for SCDO (FREE TIER ONLY)
# Replace placeholder values with actual credentials

ibm_granite:
  # IBM Granite Model Configuration (FREE TIER AVAILABLE)
  model: "granite-13b-chat-v2"
  max_tokens: 4096
  temperature: 0.7
  top_p: 0.9
  top_k: 50
  repetition_penalty: 1.1
  
  # API Configuration
  api_key: "YOUR_IBM_CLOUD_API_KEY_HERE"
  project_id: "YOUR_PROJECT_ID_HERE"
  url: "PJkCae7zNu0K29J411PklUsz_hNPxfq3E4jAMxBSnjCJRE"
  
  # Retry Configuration
  max_retries: 3
  retry_delay: 2
  timeout: 60

# Local Storage (FREE - No Cloud Storage needed)
local_storage:
  # Local file storage paths
  upload_dir: "uploads"
  output_dir: "output"
  cache_dir: "cache"

rate_limits:
  # Free Tier Limits (adjust based on your plan)
  requests_per_minute: 20
  daily_quota: 10000
  max_concurrent_requests: 2
  
  # Caching Configuration
  cache_enabled: true
  cache_ttl: 3600  # 1 hour in seconds
  cache_max_size: 1000

logging:
  level: "INFO"
  format: "json"
  file: "logs/scdo.log"
  max_size: "10MB"
  backup_count: 5

prompts:
  # System prompts for different tasks
  system_role: "You are an academic curriculum expert specializing in higher education syllabus design and optimization."
  
  analysis_context: |
    Analyze the following syllabus content with focus on:
    - Learning outcomes alignment
    - Bloom's taxonomy coverage
    - Assessment strategy effectiveness
    - Content sequencing and coherence
  
  generation_context: |
    Generate a comprehensive syllabus that meets accreditation standards
    and follows outcome-based education principles.
  
  optimization_context: |
    Suggest improvements to enhance the syllabus quality, ensuring
    alignment with modern pedagogical practices and industry requirements.
