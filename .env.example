# ============================================================
# API Keys & Service Credentials
# ============================================================

# OpenRouter (Primary AI Model Provider)
OPENROUTER_API_KEY=your_openrouter_key_here

# Google Gemini (Fallback AI Provider)
GEMINI_API_KEY=your_gemini_key_here

# ============================================================
# IBM Cloud Credentials (Optional - for Granite models)
# ============================================================

# IBM Cloud API Key
IBM_CLOUD_API_KEY=your_ibm_cloud_api_key_here

# Watson Machine Learning Service URL (e.g., https://us-south.ml.cloud.ibm.com)
IBM_WML_URL=https://us-south.ml.cloud.ibm.com

# Watson Machine Learning Instance ID
IBM_WML_INSTANCE_ID=your_wml_instance_id_here

# Watson Machine Learning CRN
IBM_WML_CRN=your_wml_crn_here

# IBM Cloud Project ID (watsonx.ai project)
IBM_PROJECT_ID=your_ibm_project_id_here

# ============================================================
# IBM Cloud Object Storage
# ============================================================

# Cloud Object Storage CRN
IBM_COS_CRN=your_cos_crn_here
