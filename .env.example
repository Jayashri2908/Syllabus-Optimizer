# ============================================================
# SCDO — Environment Variables
# ============================================================

# OpenRouter (Primary AI — FREE, recommended)
# Get your key at: https://openrouter.ai (no credit card needed)
OPENROUTER_API_KEY=your_openrouter_key_here

# Google Gemini (Fallback AI — FREE)
# Get your key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_here

# ============================================================
# Server Configuration (optional)
# ============================================================

# API authentication key (leave empty to disable auth in development)
API_KEY=

# Maximum upload file size in bytes (default: 50 MB)
# MAX_UPLOAD_SIZE=52428800

# CORS allowed origins (comma-separated, default: http://localhost:3000)
# CORS_ORIGINS=http://localhost:3000
