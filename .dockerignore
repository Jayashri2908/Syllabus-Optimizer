# =============================================================================
# Docker Build Context Exclusions
# =============================================================================

# Secrets — never bake into image
.env
.env.*
!.env.example
configs/ibm_config.yaml

# Version control
.git
.github

# Python artifacts
__pycache__
*.pyc
*.pyo
*.pyd
.Python
venv/
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/

# Node artifacts
node_modules/
webapp/frontend/node_modules/
webapp/node_modules/

# IDE and editor
.vscode/
.idea/
*.swp
*.swo

# Data & runtime (mounted as volumes at runtime)
data/
cache/
logs/
uploads/
output/

# Large docs
docs/*.pdf
docs/*.docx
docs/*.pptx

# Test files
tests/
test_*.py

# Misc
*.db
*.sqlite3
*.log
*.bat
.ai_studio_code.html
components.html
free_models.json
free_models.txt
DIRECTORY_MAP.md
